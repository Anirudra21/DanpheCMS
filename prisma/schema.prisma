// ═══════════════════════════════════════════════════════════════════════════════
// Danphe Health — Hospital Software Marketing Website CMS
// SQLite (sandbox) · For MySQL production: change provider to "mysql" and
// add @db.Text on long string fields (address, body, quote, etc.) for utf8mb4.
// ═══════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum NavLocation {
  HEADER
  FOOTER_COMPANY
  FOOTER_SOLUTIONS
  FOOTER_INFO
}

enum PostType {
  NEWS_EVENT
  COMMUNITY
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum JobStatus {
  OPEN
  CLOSED
}

enum LeadSource {
  CONTACT
  DEMO_REQUEST
  NEWSLETTER
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
  CONTENT_MANAGER
  SUPPORT
}

enum MediaCategory {
  GENERAL
  CLIENT_LOGO
  SOLUTION_ICON
  TEAM_PHOTO
  NEWS_IMAGE
  HERO_IMAGE
  FEATURE_ICON
}

enum SeoPageType {
  HOMEPAGE
  SOLUTION
  POST
  JOB
  PAGE
}

enum RedirectType {
  PERMANENT_301
  TEMPORARY_302
}

// ─── Site Settings (singleton — enforce one row at application level) ──────

model SiteSetting {
  id            String   @id @default(cuid())
  logo          String   @default("")
  email         String   @default("")
  phone         String   @default("")
  facebookUrl   String   @default("")
  instagramUrl  String   @default("")
  address       String   @default("")
  mapEmbedUrl   String   @default("")
  footerText    String   @default("")
  copyrightText String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("site_settings")
}

// ─── Navigation Items ─────────────────────────────────────────────────────

model NavItem {
  id       String      @id @default(cuid())
  label    String
  url      String
  order    Int         @default(0)
  location NavLocation
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([location, order])
  @@map("nav_items")
}

// ─── Homepage Sections (entire homepage editable) ─────────────────────────

model HomepageSection {
  id         String   @id @default(cuid())
  key        String   @unique              // e.g. "hero", "value_adds", "features_row"
  heading    String   @default("")
  subheading String   @default("")
  body       String   @default("") // rich-text / HTML
  image      String   @default("")
  ctaLabel   String   @default("")
  ctaUrl     String   @default("")
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([order])
  @@map("homepage_sections")
}

// ─── Solutions ─────────────────────────────────────────────────────────────

model Solution {
  id               String           @id @default(cuid())
  title            String
  slug             String           @unique
  shortDescription String           @default("")
  body             String           @default("")
  iconUrl          String           @default("")
  heroImageUrl     String           @default("")
  order            Int              @default(0)
  isPublished      Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  features         SolutionFeature[]

  @@index([slug])
  @@index([order])
  @@index([isPublished, order])
  @@map("solutions")
}

model SolutionFeature {
  id         String   @id @default(cuid())
  label      String
  order      Int      @default(0)
  solutionId String
  solution   Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([solutionId, order])
  @@map("solution_features")
}

// ─── Team Members ──────────────────────────────────────────────────────────

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  title       String   @default("")
  photoUrl    String   @default("")
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([isPublished, order])
  @@map("team_members")
}

// ─── Stats ─────────────────────────────────────────────────────────────────

model Stat {
  id        String   @id @default(cuid())
  label     String
  value     String
  suffix    String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("stats")
}

// ─── Testimonials ──────────────────────────────────────────────────────────

model Testimonial {
  id         String   @id @default(cuid())
  quote      String  
  authorName String
  authorOrg  String   @default("")
  imageUrl   String   @default("")
  order      Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([order])
  @@index([isPublished, order])
  @@map("testimonials")
}

// ─── Client Logos ──────────────────────────────────────────────────────────

model ClientLogo {
  id              String   @id @default(cuid())
  name            String
  logoUrl         String   @default("")
  order           Int      @default(0)
  showOnHomepage  Boolean  @default(true)
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([order])
  @@index([showOnHomepage, order])
  @@index([isPublished])
  @@map("client_logos")
}

// ─── Posts (News & Events / Community) ─────────────────────────────────────

model Post {
  id            String     @id @default(cuid())
  title         String    
  slug          String     @unique
  coverImageUrl String     @default("")
  author        String     @default("")
  publishedAt   DateTime?
  excerpt       String     @default("")
  body          String     @default("") // rich-text / Tiptap HTML
  type          PostType
  status        PostStatus @default(DRAFT)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([slug])
  @@index([type, status])
  @@index([publishedAt(sort: Desc)])
  @@map("posts")
}

// ─── Jobs / Careers ────────────────────────────────────────────────────────

model Job {
  id             String     @id @default(cuid())
  title          String
  department     String     @default("")
  location       String     @default("")
  employmentType String     @default("")
  description    String     @default("")
  requirements   String     @default("")
  applyEmail     String     @default("")
  status         JobStatus  @default(OPEN)
  order          Int        @default(0)
  postedAt       DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, postedAt(sort: Desc)])
  @@index([department])
  @@map("jobs")
}

// ─── Leads (Contact / Demo / Newsletter) ───────────────────────────────────

model Lead {
  id        String     @id @default(cuid())
  name      String     @default("")
  email     String     @default("")
  phone     String     @default("")
  message   String     @default("")
  source    LeadSource
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([source])
  @@index([createdAt(sort: Desc)])
  @@index([email])
  @@map("leads")
}

// ─── Admin Users ───────────────────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String    @default("")
  role         AdminRole @default(EDITOR)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

// ─── Globe Countries (Trusted Across Borders) ─────────────────────────────

model GlobeCountry {
  id            String   @id @default(cuid())
  countryName   String
  latitude      Float
  longitude     Float
  hospitalCount Int      @default(0)
  displayLabel  String   @default("")   // e.g. "60+ Hospitals"
  isHighlighted Boolean  @default(false) // Nepal = highlighted
  isActive      Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([order])
  @@index([isActive, order])
  @@map("globe_countries")
}

// ─── Media Library ──────────────────────────────────────────────────────

model Media {
  id         String        @id @default(cuid())
  filename   String
  alt        String        @default("")
  url        String
  mimeType   String        @default("")
  size       Int           @default(0)
  width      Int           @default(0)
  height     Int           @default(0)
  category   MediaCategory @default(GENERAL)
  uploadedBy String        @default("")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@map("media")
}

// ─── Activity Log ───────────────────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String   @default("")
  userName   String   @default("")
  action     String   // CREATE, UPDATE, DELETE, PUBLISH, LOGIN, etc.
  resource   String   // e.g. "Solution", "Post", "HomepageSection"
  resourceId String   @default("")
  details    String   @default("") // JSON string with change details
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([resource])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("activity_logs")
}

// ─── System Config (flexible key-value store) ───────────────────────────

model SystemConfig {
  key       String   @id
  value     String   @default("{}") // JSON-encoded config
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}

// ─── SEO Global Settings ────────────────────────────────────────────────

model SeoGlobal {
  id               String   @id @default(cuid())
  titleTemplate    String   @default("%s | Danphe Health")
  metaDescription  String   @default("")
  ogImageUrl       String   @default("")
  faviconUrl       String   @default("")
  googleVerify     String   @default("")
  bingVerify       String   @default("")
  faqSchemaEnabled Boolean  @default(false)
  robotsTxt        String   @default("User-agent: *\nAllow: /\nDisallow: /admin/\nSitemap: https://danphehealth.com/sitemap.xml")
  sitemapUrl       String   @default("https://danphehealth.com/sitemap.xml")
  lastSitemapGen   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("seo_globals")
}

// ─── SEO Per-Page Meta ──────────────────────────────────────────────────

model SeoPageMeta {
  id          String      @id @default(cuid())
  pageType    SeoPageType
  pageSlug    String      @default("")
  pageTitle   String      @default("")
  metaTitle   String      @default("")
  metaDesc    String      @default("")
  canonicalUrl String     @default("")
  ogImageUrl  String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([pageType, pageSlug])
  @@index([pageType])
  @@map("seo_page_metas")
}

// ─── Redirect Rules ─────────────────────────────────────────────────────

model RedirectRule {
  id        String       @id @default(cuid())
  fromPath  String       @unique
  toPath    String
  type      RedirectType @default(PERMANENT_301)
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("redirect_rules")
}
