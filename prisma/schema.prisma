// ═══════════════════════════════════════════════════════════════════════════════
// Danphe Health — Hospital Software Marketing Website CMS
// Prisma Schema · MySQL (utf8mb4)
// ═══════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum NavLocation {
  HEADER
  FOOTER_COMPANY
  FOOTER_SOLUTIONS
  FOOTER_INFO
}

enum PostType {
  NEWS_EVENT
  COMMUNITY
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum JobStatus {
  OPEN
  CLOSED
}

enum LeadSource {
  CONTACT
  DEMO_REQUEST
  NEWSLETTER
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

// ─── Site Settings (singleton — enforce one row at application level) ──────

model SiteSetting {
  id            String   @id @default(cuid())
  logo          String   @default("")
  email         String   @default("")
  phone         String   @default("")
  facebookUrl   String   @default("")
  instagramUrl  String   @default("")
  address       String   @default("") @db.Text
  mapEmbedUrl   String   @default("") @db.Text
  footerText    String   @default("") @db.Text
  copyrightText String   @default("") @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("site_settings")
}

// ─── Navigation Items ─────────────────────────────────────────────────────

model NavItem {
  id       String      @id @default(cuid())
  label    String
  url      String
  order    Int         @default(0)
  location NavLocation
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([location, order])
  @@map("nav_items")
}

// ─── Homepage Sections (entire homepage editable) ─────────────────────────

model HomepageSection {
  id         String   @id @default(cuid())
  key        String   @unique              // e.g. "hero", "value_adds", "features_row"
  heading    String   @default("") @db.Text
  subheading String   @default("") @db.Text
  body       String   @default("") @db.Text // rich-text / HTML
  image      String   @default("")
  ctaLabel   String   @default("")
  ctaUrl     String   @default("")
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([order])
  @@map("homepage_sections")
}

// ─── Solutions ─────────────────────────────────────────────────────────────

model Solution {
  id               String           @id @default(cuid())
  title            String
  slug             String           @unique
  shortDescription String           @default("") @db.Text
  body             String           @default("") @db.Text
  iconUrl          String           @default("")
  heroImageUrl     String           @default("")
  order            Int              @default(0)
  isPublished      Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  features         SolutionFeature[]

  @@index([slug])
  @@index([order])
  @@index([isPublished, order])
  @@map("solutions")
}

model SolutionFeature {
  id         String   @id @default(cuid())
  label      String
  order      Int      @default(0)
  solutionId String
  solution   Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([solutionId, order])
  @@map("solution_features")
}

// ─── Team Members ──────────────────────────────────────────────────────────

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  title       String   @default("")
  photoUrl    String   @default("")
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([isPublished, order])
  @@map("team_members")
}

// ─── Stats ─────────────────────────────────────────────────────────────────

model Stat {
  id        String   @id @default(cuid())
  label     String
  value     String
  suffix    String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("stats")
}

// ─── Testimonials ──────────────────────────────────────────────────────────

model Testimonial {
  id         String   @id @default(cuid())
  quote      String   @db.Text
  authorName String
  authorOrg  String   @default("")
  imageUrl   String   @default("")
  order      Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([order])
  @@index([isPublished, order])
  @@map("testimonials")
}

// ─── Client Logos ──────────────────────────────────────────────────────────

model ClientLogo {
  id              String   @id @default(cuid())
  name            String
  logoUrl         String   @default("")
  order           Int      @default(0)
  showOnHomepage  Boolean  @default(true)
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([order])
  @@index([showOnHomepage, order])
  @@index([isPublished])
  @@map("client_logos")
}

// ─── Posts (News & Events / Community) ─────────────────────────────────────

model Post {
  id            String     @id @default(cuid())
  title         String     @db.Text
  slug          String     @unique
  coverImageUrl String     @default("")
  author        String     @default("")
  publishedAt   DateTime?
  excerpt       String     @default("") @db.Text
  body          String     @default("") @db.Text // rich-text / Tiptap HTML
  type          PostType
  status        PostStatus @default(DRAFT)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([slug])
  @@index([type, status])
  @@index([publishedAt(sort: Desc)])
  @@map("posts")
}

// ─── Jobs / Careers ────────────────────────────────────────────────────────

model Job {
  id             String     @id @default(cuid())
  title          String
  department     String     @default("")
  location       String     @default("")
  employmentType String     @default("")
  description    String     @default("") @db.Text
  requirements   String     @default("") @db.Text
  applyEmail     String     @default("")
  status         JobStatus  @default(OPEN)
  postedAt       DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, postedAt(sort: Desc)])
  @@index([department])
  @@map("jobs")
}

// ─── Leads (Contact / Demo / Newsletter) ───────────────────────────────────

model Lead {
  id        String     @id @default(cuid())
  name      String     @default("")
  email     String     @default("")
  phone     String     @default("")
  message   String     @default("") @db.Text
  source    LeadSource
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([source])
  @@index([createdAt(sort: Desc)])
  @@index([email])
  @@map("leads")
}

// ─── Admin Users ───────────────────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String    @default("")
  role         AdminRole @default(EDITOR)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}
